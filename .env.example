# NASA Open Data API Key (Get yours free at https://api.nasa.gov/ - defaults to DEMO_KEY if empty)
NASA_API_KEY=

# Anthropic Claude API Key (Optional: for AI explain endpoint - falls back to deterministic rule engine if empty)
ANTHROPIC_API_KEY=

# Anthropic Claude Model Identifier (Default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Canonical Deployment Site URL (Optional: used for sitemap.xml and robots.txt generation)
SITE_URL=
